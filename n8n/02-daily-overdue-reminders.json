        "batchSize": 1,
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000205",
      "name": "Loop over loans",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        800,
        200
