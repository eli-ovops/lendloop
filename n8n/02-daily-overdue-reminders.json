    {
      "parameters": {
        "jsCode": "// SMTP returns a receipt, so use the linked item for the event identity.\nfunction sign(rawBody) {\n  const secret = $env.LENDLOOP_WEBHOOK_SECRET;\n  if (!secret) throw new Error('LENDLOOP_WEBHOOK_SECRET is not set in the n8n environment.');\n  return require('crypto').createHmac('sha256', secret).update(rawBody, 'utf8').digest('hex');\n}\nfunction convexUrl(path) {\n  const base = ($env.CONVEX_SITE_URL || '').replace(/\\/$/, '');\n  if (!base) throw new Error('CONVEX_SITE_URL is not set in the n8n environment (use the .convex.site URL).');\n  return base + path;\n}\nconst item = $('Loop over loans').itemMatching(0).json;\nconst rawBody = JSON.stringify({\n  eventId: item.eventId,\n  borrowRequestId: item.borrowRequestId,\n  daysOverdue: item.daysOverdue,\n});\nreturn [{ json: {\n  rawBody,\n  signature: 'sha256=' + sign(rawBody),\n  url: convexUrl('/n8n/reminder-logged'),\n}, pairedItem: { item: 0 } }];"
      },
