    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nconst site = ($env.CONVEX_SITE_URL || '').replace(/\\/$/, '');\nif (!secret || !site) throw new Error('Configure the Convex site URL and shared secret.');\nconst rawBody = JSON.stringify({\n  eventId: item.eventId,\n  kind: 'overdue_reminder',\n  borrowRequestId: item.borrowRequestId,\n});\nconst signature = require('crypto').createHmac('sha256', secret).update(rawBody, 'utf8').digest('hex');\nreturn [{\n  json: { rawBody, signature: 'sha256=' + signature, url: site + '/n8n/claim-email' },\n  pairedItem: { item: 0 },\n}];"
      },
      "id": "3d4c6bdf-8f35-4e63-b55b-da28626cb159",
